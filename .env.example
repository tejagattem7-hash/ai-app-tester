OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-id

# Optional backend test account. Users can enter credentials in the UI instead.
TEST_AUTH_ORIGIN=
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=

# Backend only: enable the capability; each request still requires user opt-in.
TRANSACTIONAL_MODE_ENABLED=false
