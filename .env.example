OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=your-openai-model-id

# Optional backend test account. Users can enter credentials in the UI instead.
TEST_AUTH_ORIGIN=
TEST_AUTH_USERNAME=
TEST_AUTH_PASSWORD=

# Backend kill switch. The UI option is available by default and unchecked.
# Set false to disable it for every user.
TRANSACTIONAL_MODE_ENABLED=true

# Optional: only the IP/CIDR of a trusted HTTPS-terminating reverse proxy.
# The proxy must preserve Host and overwrite X-Forwarded-Proto.
TRUST_PROXY_CIDRS=
