  "lifePlannerPlan": {
    "status": 200,
    "body": {
      "pagePurpose": "Introduce an AI-assisted life planner for work, schedules, goals, health, fitness, and meals, and provide account-registration and login entry points. The exploration reached the landing page and authentication forms, but not planner features, submission results, or validation states.",
      "tests": [
        {
          "id": "landing-purpose-and-features",
          "title": "Present the planner's purpose and advertised feature areas",
          "category": "content",
          "reason": "Confirm that visitors can understand the product's scope without assuming its advertised planning workflows are accessible.",
          "expectedOutcome": "The landing page displays its main value proposition and the four observed feature headings.",
          "actions": [
            {
              "type": "navigate",
              "url": "https://ai-life-planner-seven.vercel.app/"
            },
            {
              "type": "assertText",
              "target": "Main heading",
              "text": "Make time for the life you actually want."
            },
            {
              "type": "assertText",
              "target": "Feature section heading",
              "text": "Planning that sees the bigger picture."
            },
            {
              "type": "assertText",
              "target": "AI Planning feature heading",
              "text": "AI Planning"
            },
            {
              "type": "assertText",
              "target": "Smart Calendar feature heading",
              "text": "Smart Calendar"
            },
            {
              "type": "assertText",
              "target": "Goals feature heading",
              "text": "Goals"
            },
            {
              "type": "assertText",
              "target": "Health & Fitness feature heading",
              "text": "Health & Fitness"
            }
          ]
        },
        {
          "id": "get-started-registration-fields",
          "title": "Open registration and enter required and optional details without submitting",
          "category": "functional",
          "reason": "Exercise the primary onboarding entry point and every discovered registration field without creating an account.",
          "expectedOutcome": "Get Started opens the account-creation form at /auth. Its fields accept entry, and the account-creation heading remains visible without submission.",
          "actions": [
            {
              "type": "navigate",
              "url": "https://ai-life-planner-seven.vercel.app/"
            },
            {
              "type": "click",
              "target": "Get Started →"
            },
            {
              "type": "assertUrl",
              "url": "https://ai-life-planner-seven.vercel.app/auth"
            },
            {
              "type": "assertText",
              "target": "Registration heading",
              "text": "Create your account"
            },
            {
              "type": "fill",
              "target": "Full name",
              "value": "Alex Taylor"
            },
            {
              "type": "fill",
              "target": "Home address",
              "value": "123 Example Street"
            },
            {
              "type": "fill",
              "target": "Work address",
              "value": "456 Sample Avenue"
            },
            {
              "type": "fill",
              "target": "Phone optional",
              "value": "+12025550123"
            },
            {
              "type": "fill",
              "target": "Email",
              "value": "alex.taylor@example.com"
            },
            {
              "type": "fill",
              "target": "Password",
              "value": "ExampleOnly!4827"
            },
            {
              "type": "assertText",
              "target": "Registration heading",
              "text": "Create your account"
            }
          ]
        },
        {
          "id": "sign-in-entry-observed-destination",
          "title": "Verify the observed destination of the landing-page Sign in button",
          "category": "navigation",
          "reason": "The recorded Sign in transition opens registration rather than the login state; this distinct entry-point behavior should be checked explicitly.",
          "expectedOutcome": "Sign in opens /auth with the Create your account heading and registration explanation, matching the observed transition.",
          "actions": [
            {
              "type": "navigate",
              "url": "https://ai-life-planner-seven.vercel.app/"
            },
            {
              "type": "click",
              "target": "Sign in"
            },
            {
              "type": "assertUrl",
              "url": "https://ai-life-planner-seven.vercel.app/auth"
            },
            {
              "type": "assertText",
              "target": "Registration heading",
              "text": "Create your account"
            },
            {
              "type": "assertText",
              "target": "Registration introductory paragraph",
              "text": "Add the details your planner needs to understand your day."
            }
          ]
        },
        {
          "id": "switch-to-login-and-enter-credentials",
          "title": "Switch from registration to login and enter credentials without submitting",
          "category": "functional",
          "reason": "Exercise the recorded authentication-mode transition, which changes visible state without changing the URL, and the discovered login fields.",
          "expectedOutcome": "Log in switches the registration form to the Welcome back state at the same /auth URL. Email and password entry is possible without attempting authentication.",
          "actions": [
            {
              "type": "navigate",
              "url": "https://ai-life-planner-seven.vercel.app/"
            },
            {
              "type": "click",
              "target": "Get Started →"
            },
            {
              "type": "click",
              "target": "Log in"
            },
            {
              "type": "assertUrl",
              "url": "https://ai-life-planner-seven.vercel.app/auth"
            },
            {
              "type": "assertText",
              "target": "Login heading",
              "text": "Welcome back"
            },
            {
              "type": "fill",
              "target": "Email",
              "value": "alex.taylor@example.com"
            },
            {
              "type": "fill",
              "target": "Password",
              "value": "ExampleOnly!4827"
            },
            {
              "type": "assertText",
              "target": "Login introductory paragraph",
              "text": "Sign in to continue to your planner."
            },
            {
              "type": "assertText",
              "target": "Forgot password? button",
              "text": "Forgot password?"
            }
          ]
        }
      ]
    }
  }
